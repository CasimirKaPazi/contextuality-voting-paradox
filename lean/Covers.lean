/-
  Proposition 1 of *Covers and Division* (`notes/covers-and-division.md`,
  Section 1): the global sections of a loop are exactly the global sections
  of its k-fold cover fixed by ℤ/k.

  Encoding as in `LoopsOfRelations.lean`: one value type `V`, relations
  `R i` for the contexts, and a global section of the loop of length n as an
  assignment `f : ℕ → V` of period n with `R (i % n) (f i) (f (i + 1))` for
  every i (`IsSection`; `Loops.Section` is its existence). The k-fold cover is
  the loop of length k·n whose j-th context allows `R (j % n)` (`Cover`). The
  deck transformation moves every index by n (`deck`); ℤ/k is generated by it.

  * `deck_section`: the deck transformation maps sections of the cover to
    sections of the cover, so ℤ/k acts on them.
  * `prop1`: an assignment is a section of the loop exactly when it is a
    section of the k-fold cover fixed by the deck transformation.
  * `section_iff_cover`: the loop has a global section exactly when the
    k-fold cover has one fixed by ℤ/k.

  Neither n > 0 nor k > 0 is needed for these statements.
-/

module

public import LoopsOfRelations

@[expose] public section

namespace Covers

variable {V : Type*}

/-- f is a global section of the loop of length n with relations R. -/
def IsSection (R : ℕ → V → V → Prop) (n : ℕ) (f : ℕ → V) : Prop :=
  (∀ i, f (i + n) = f i) ∧ ∀ i, R (i % n) (f i) (f (i + 1))

theorem section_iff (R : ℕ → V → V → Prop) (n : ℕ) : Loops.Section R n ↔ ∃ f, IsSection R n f :=
  Iff.rfl

/-- The relations of the covers of a loop of length n: the j-th context allows
    `R (j mod n)`. The k-fold cover is the loop of length k·n with these
    relations. -/
def Cover (R : ℕ → V → V → Prop) (n : ℕ) : ℕ → V → V → Prop := fun j => R (j % n)

/-- The deck transformation: every index moves by n. -/
def deck (n : ℕ) (f : ℕ → V) : ℕ → V := fun i => f (i + n)

/-- A function of period n has period k·n. -/
lemma periodic_mul {f : ℕ → V} {n : ℕ} (h : ∀ i, f (i + n) = f i) (k : ℕ) :
    ∀ i, f (i + k * n) = f i := by
  induction k with
  | zero => intro i; simp
  | succ k ih =>
    intro i
    rw [add_one_mul, ← Nat.add_assoc, h, ih]

/-- The relation of the cover at position j is that of the loop at j mod n. -/
lemma cover_mod (R : ℕ → V → V → Prop) (n k j : ℕ) :
    Cover R n (j % (k * n)) = R (j % n) := by
  show R (j % (k * n) % n) = R (j % n)
  rw [Nat.mod_mod_of_dvd _ (dvd_mul_left n k)]

/-- ℤ/k acts on the sections of the k-fold cover. -/
theorem deck_section (R : ℕ → V → V → Prop) (n k : ℕ) {f : ℕ → V}
    (h : IsSection (Cover R n) (k * n) f) : IsSection (Cover R n) (k * n) (deck n f) := by
  refine ⟨fun i => ?_, fun i => ?_⟩
  · show f (i + k * n + n) = f (i + n)
    rw [Nat.add_right_comm i (k * n) n, h.1]
  · have hi := h.2 (i + n)
    rw [cover_mod, Nat.add_mod_right] at hi
    show Cover R n (i % (k * n)) (f (i + n)) (f (i + 1 + n))
    rw [cover_mod, Nat.add_right_comm i 1 n]
    exact hi

/-- **Proposition 1.** The global sections of the loop are exactly the global
    sections of the k-fold cover fixed by the deck transformation. -/
theorem prop1 (R : ℕ → V → V → Prop) (n k : ℕ) (f : ℕ → V) :
    IsSection R n f ↔ IsSection (Cover R n) (k * n) f ∧ deck n f = f := by
  constructor
  · rintro ⟨hper, hR⟩
    refine ⟨⟨periodic_mul hper k, fun i => ?_⟩, funext hper⟩
    rw [cover_mod]
    exact hR i
  · rintro ⟨⟨-, hR⟩, hfix⟩
    refine ⟨fun i => congrFun hfix i, fun i => ?_⟩
    have hi := hR i
    rw [cover_mod] at hi
    exact hi

/-- The loop has a global section exactly when its k-fold cover has one fixed
    by ℤ/k. -/
theorem section_iff_cover (R : ℕ → V → V → Prop) (n k : ℕ) :
    Loops.Section R n ↔ ∃ f, IsSection (Cover R n) (k * n) f ∧ deck n f = f := by
  rw [section_iff]
  exact exists_congr fun f => prop1 R n k f

end Covers
